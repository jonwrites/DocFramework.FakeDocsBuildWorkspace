{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "artifacts/*.dll",
            "artifacts/*.xml"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "docs/**",
          "api/**",
          "**/*.md",
          "toc.yml"
        ],
        "exclude": [
          "**/artifacts/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "JLib Services",
      "_appTitle": "JLib Services",
      "_enableSearch": true,
      "pdf": true
    }
  }
}