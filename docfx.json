{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "artifacts/*.dll",
            "artifacts/*.xml"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "docs/**",
          "api/**",
          "**/*.md",
          "toc.yml"
        ],
        "exclude": [
          "**/artifacts/**"
        ]
      }
    ],
    "output": "_site"
  }
}